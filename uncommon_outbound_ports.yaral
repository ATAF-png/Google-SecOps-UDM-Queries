rule uncommon_outbound_ports {
  meta:
    author = "Aaron"
    description = "Detect network connections outbound to non-standard or risky ports (e.g., direct connections over port 4444 or 6667)"
    severity = "Medium"
    technique = "T1571"



  events:
    $e.metadata.event_type = "NETWORK_CONNECTION"
    $e.target.port = 4444 or $e.target.port = 6667 or $e.target.port = 9001
    $e.security_result.action = "ALLOW"


  condition:
    $e
}